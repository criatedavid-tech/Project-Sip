    "@nestjs/platform-express": "^11.0.1",
    "@omni/auth": "workspace:*",
    "@omni/config": "workspace:*",
    "@omni/db": "workspace:*",
    "@omni/observability": "workspace:*",
    "@omni/provider-contracts": "workspace:*",
    "@omni/queue-kit": "workspace:*",
    "@omni/testing": "workspace:*",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.38.2",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@omni/eslint-config": "workspace:*",
    "@omni/tsconfig": "workspace:*",
    "@types/cookie-parser": "^1.4.8",
