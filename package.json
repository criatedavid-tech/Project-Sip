{
  "name": "omni-platform",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run dev",
    "lint": "turbo run lint",
    "test": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "eslint": "10.8.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
