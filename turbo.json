{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      // O Turborepo isola o ambiente por padrão; sem declarar, os testes de
      // integração não enxergam o banco e se auto-pulam silenciosamente.
      "env": ["DATABASE_URL", "DATABASE_ADMIN_URL", "REDIS_URL", "NODE_ENV"]
    }
  }
}
