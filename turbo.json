{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "LOG_LEVEL",
        "API_PORT",
        "WEB_BASE_URL",
        "DATABASE_URL",
        "DATABASE_ADMIN_URL",
        "REDIS_URL",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "JWT_ACCESS_TTL",
        "JWT_REFRESH_TTL",
        "STORAGE_ENDPOINT",
        "STORAGE_REGION",
        "STORAGE_BUCKET",
        "STORAGE_ACCESS_KEY_ID",
        "STORAGE_SECRET_ACCESS_KEY",
        "STORAGE_FORCE_PATH_STYLE",
        "STORAGE_SIGNED_URL_TTL_SECONDS",
        "SIP_PROVIDER_DRIVER",
        "WHATSAPP_PROVIDER_DRIVER",
        "TRANSCRIPTION_PROVIDER_DRIVER",
        "TRANSCRIPTION_PROVIDER",
        "TRANSCRIPTION_API_KEY",
        "TRANSCRIPTION_MODEL",
        "TRANSCRIPTION_LANGUAGE",
        "TRANSCRIPTION_REQUEST_TIMEOUT_MS",
        "TRANSCRIPTION_LOCAL_URL",
        "TRANSCRIPTION_BACKLOG_INTERVAL_MS",
        "ASTERISK_ARI_URL",
        "ASTERISK_ARI_USERNAME",
        "ASTERISK_ARI_PASSWORD",
        "ASTERISK_ARI_APP",
        "ASTERISK_ARI_RECONNECT_DELAY_MS",
        "ASTERISK_WSS_URL",
        "ASTERISK_WEBRTC_DOMAIN",
        "ASTERISK_WEBRTC_1001_PASSWORD",
        "ASTERISK_WEBRTC_1002_PASSWORD",
        "ASTERISK_RECORDINGS_PATH",
        "META_PHONE_NUMBER_ID",
        "META_APP_SECRET",
        "META_ACCESS_TOKEN",
        "META_WEBHOOK_VERIFY_TOKEN",
        "META_GRAPH_API_VERSION",
        "NEXT_PUBLIC_API_BASE_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      // O Turborepo isola o ambiente por padrão; sem declarar, os testes de
      // integração não enxergam o banco e se auto-pulam silenciosamente.
      "env": ["DATABASE_URL", "DATABASE_ADMIN_URL", "REDIS_URL", "NODE_ENV"]
    }
  }
}
