# =============================================================================
# Copie para .env e preencha. NUNCA commitar o .env preenchido.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug

# --- API / Web ---------------------------------------------------------------
API_PORT=3001
WEB_PORT=3000
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# --- PostgreSQL --------------------------------------------------------------
# Duas conexões distintas de propósito: o Postgres deixa superusuário IGNORAR
# Row Level Security (inclusive com FORCE), então rodar a aplicação com o
# usuário dono das tabelas desligaria o isolamento multi-tenant silenciosamente.
POSTGRES_USER=omni
POSTGRES_PASSWORD=omni_dev_password
POSTGRES_DB=omni
POSTGRES_PORT=5432

# Administrativa: cria tabelas e roda migrações. NÃO usar na aplicação.
DATABASE_ADMIN_URL=postgres://omni:omni_dev_password@localhost:5432/omni

# Aplicação: role restrita, sujeita ao RLS. É esta que a API usa.
APP_DB_USER=omni_app
APP_DB_PASSWORD=omni_app_dev_password
DATABASE_URL=postgres://omni_app:omni_app_dev_password@localhost:5432/omni

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Storage S3-compatible (MinIO em dev) ------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=omni-recordings
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL_SECONDS=300

# --- Autenticação ------------------------------------------------------------
# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Seleção de drivers dos provedores (mock | real) -------------------------
SIP_PROVIDER_DRIVER=mock
WHATSAPP_PROVIDER_DRIVER=mock
TRANSCRIPTION_PROVIDER_DRIVER=mock

# --- Telefonia SIP / Asterisk (Fase 3) ---------------------------------------
# Valores reais ainda NÃO definidos — ver seção 18 do plano de arquitetura.
ASTERISK_ARI_URL=http://localhost:8088
ASTERISK_ARI_USERNAME=
ASTERISK_ARI_PASSWORD=
ASTERISK_ARI_APP=omnichannel
ASTERISK_ARI_RECONNECT_DELAY_MS=5000
ASTERISK_WSS_URL=ws://localhost:8088/ws
ASTERISK_WEBRTC_DOMAIN=localhost
ASTERISK_EXTERNAL_ADDRESS=
ASTERISK_STUN_ADDRESS=stun.l.google.com:19302
ASTERISK_WEBRTC_1001_PASSWORD=
ASTERISK_WEBRTC_1002_PASSWORD=
# Segredo mestre opcional para ramais acima de 1002. Se vazio, o ambiente local
# deriva as credenciais a partir das duas senhas legadas acima.
ASTERISK_WEBRTC_SECRET=
ASTERISK_EXTENSION_START=1001
ASTERISK_EXTENSION_END=1099
ASTERISK_QUEUE_NAME=vendas
ASTERISK_QUEUE_STRATEGY=rrmemory
ASTERISK_QUEUE_MEMBER_TIMEOUT=20
ASTERISK_QUEUE_RETRY=3
ASTERISK_QUEUE_WRAPUP=5
ASTERISK_QUEUE_MAX_WAIT=45
ASTERISK_RECORDINGS_PATH=infra/.local/asterisk-recordings
ASTERISK_SIP_PORT=5060
ASTERISK_HTTP_PORT=8088
ASTERISK_RTP_START=10000
ASTERISK_RTP_END=10099

SIP_PROVIDER="<SIP_PROVIDER>"
SIP_TRUNK_HOST="<SIP_TRUNK_HOST>"
SIP_AUTH_METHOD="<SIP_AUTH_METHOD>"
SIP_USERNAME="<SIP_USERNAME>"
SIP_PASSWORD=
SIP_PHONE_NUMBER="<SIP_PHONE_NUMBER>"
SIP_SUPPORTED_CODECS="<SIP_SUPPORTED_CODECS>"

# --- Chamadas de voz pelo WhatsApp / WaVoIP ---------------------------------
# Credenciais geradas em Integrações > SIP no painel WaVoIP.
WAVOIP_SIP_HOST=sipv2.wavoip.com
WAVOIP_SIP_PORT=5060
WAVOIP_SIP_USERNAME=
WAVOIP_SIP_PASSWORD=
WAVOIP_CALLER_ID=
WAVOIP_SUPPORTED_CODECS=alaw,ulaw

# Eventos do provedor de voz: use ao menos 32 caracteres aleatórios. O ID da
# organização é opcional; quando vazio, a API roteia pelo número cadastrado.
WHATSAPP_VOICE_WEBHOOK_TOKEN=
WHATSAPP_VOICE_ORGANIZATION_ID=

# --- Twilio Elastic SIP Trunking --------------------------------------------
# O IP publico da VPS deve estar no IP ACL do tronco. Nao usa registro SIP.
TWILIO_SIP_DOMAIN=<SIP_TRUNK_DOMAIN>
TWILIO_CALLER_ID=
TWILIO_SUPPORTED_CODECS=ulaw,alaw

# Nvoip SIP (registro por usuario e senha)
NVOIP_SIP_HOST=app.nvoip.com.br
NVOIP_SIP_PORT=5060
NVOIP_SIP_USERNAME=
NVOIP_SIP_PASSWORD=
NVOIP_CALLER_ID=
NVOIP_SUPPORTED_CODECS=alaw,ulaw

# --- WhatsApp Business Platform / Meta (Fase 2) ------------------------------
# Valores reais ainda NÃO definidos — ver seção 18 do plano de arquitetura.
META_BUSINESS_ID="<META_BUSINESS_ID>"
META_WABA_ID="<META_WABA_ID>"
META_PHONE_NUMBER_ID="<META_PHONE_NUMBER_ID>"
META_APP_ID="<META_APP_ID>"
META_APP_SECRET=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
# Token arbitrário que você define e informa no painel da Meta ao cadastrar o webhook.
META_WEBHOOK_VERIFY_TOKEN=

# --- Transcrição pós-chamada -------------------------------------------------
# Local: faster-whisper em Docker. OpenAI continua disponível como alternativa.
TRANSCRIPTION_PROVIDER=whisper_local
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=small
TRANSCRIPTION_LANGUAGE=pt
TRANSCRIPTION_LOCAL_URL=http://127.0.0.1:8090/v1/transcriptions
TRANSCRIPTION_REQUEST_TIMEOUT_MS=900000
TRANSCRIPTION_BACKLOG_INTERVAL_MS=60000
WHISPER_PORT=8090
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8
WHISPER_BEAM_SIZE=5
WHISPER_MAX_UPLOAD_MB=250

# --- Infra / conformidade ----------------------------------------------------
OBJECT_STORAGE_PROVIDER="<OBJECT_STORAGE_PROVIDER>"
DEPLOYMENT_PROVIDER="<DEPLOYMENT_PROVIDER>"
DEFAULT_DATA_RETENTION_DAYS="<DEFAULT_DATA_RETENTION_DAYS>"
